DATABASE_URL="postgresql://streamgive:streamgive@localhost:5432/streamgive"
PORT=3000
SOROBAN_RPC_URL="https://soroban-testnet.stellar.org"

# The live testnet deployment (see streamgive-contracts/deployments.json).
# Public contract ids, not secrets.
NGO_REGISTRY_CONTRACT_ID="CCPWQBI7FV2CZ7EECOVZ5XHOHK5S7CS6XTBDWPWHBEOKPTIASNGOBQFH"
DONATION_VAULT_CONTRACT_ID="CDLKBGX3VTFZZBVBNQYHF47PQO6I7UTBYVVQE3BPJDONF6G4U33Z7VLH"

INDEXER_POLL_INTERVAL_MS=5000

# Comma-separated origins allowed to call this API from a browser.
# Must include the frontend's origin or every request fails as
# "Failed to fetch". Defaults to the local frontend when unset.
CORS_ORIGINS="http://localhost:3001"

# Stellar public key (G...) that must sign requests to admin routes —
# should match the `admin` set on the deployed contracts.
ADMIN_ADDRESS="GA4Z4GPSO3FKPMQJ3WCMU5D5WE25SDXZS47YDF3J3NWF65ILGCVJVWIJ"

# Optional: additional admin keys, comma-separated, unioned with
# ADMIN_ADDRESS above. Set this when more than one key needs to sign admin
# requests (key rotation, several operators). Either variable alone is
# enough; admin routes 503 only when both are empty.
ADMIN_ADDRESSES=""

# Optional: if set, stream lifecycle events are POSTed here as JSON.
NOTIFY_WEBHOOK_URL=

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Leave unset locally — set to "production" only in deployment, where it
# also switches logging from pino-pretty to structured JSON. The Docker
# image sets this itself; see ENVIRONMENT.md.
# NODE_ENV=production
