generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Pinned rather than inferred. Prisma decides this from the surrounding
  // project when it is not set, and the Docker build runs `prisma generate`
  // during `npm ci` - before tsconfig.json has been copied in - so it
  // guessed .ts there and .js locally. tsc copies specifiers through
  // verbatim, so the image ended up importing .ts files that do not exist
  // in dist/ and crashed on boot with ERR_MODULE_NOT_FOUND.
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Donor {
  id        String   @id @default(uuid())
  address   String   @unique
  createdAt DateTime @@default(now()) @map("created_at")
  streams   Stream[]

  @@map("donors")
}

model Ngo {
  id           String   @id @default(uuid())
  ownerAddress String   @unique @map("owner_address")
  name         String
  verified     Boolean  @default(false)
  createdAt    DateTime @@default(now()) @map("created_at")
  updatedAt    DateTime @@updatedAt @map("updated_at")
  streams      Stream[]

  @@map("ngos")
}

enum StreamStatus {
  ACTIVE
  CANCELLED
}

enum StreamEventType {
  CREATED
  TOPUP
  RATE_CHANGED
  WITHDRAWAL
  CANCELLED
}

model Stream {
  id           String       @id @default(uuid())
  /// Stream id as assigned by the donation-vault contract.
  onChainId    BigInt       @unique @map("on_chain_id")
  donorId      String       @map("donor_id")
  donor        Donor        @relation(fields: [donorId], references: [id])
  ngoId         String       @map("ngo_id")
  ngo           Ngo          @relation(fields: [ngoId], references: [id])
  tokenAddress String       @map("token_address")
  /// i128 values from the contract, stored as decimal strings to avoid
  /// precision loss — Postgres bigint/numeric mapping is handled at the
  /// application layer, not by Prisma's native int types.
  rate          String
  balance       String
  withdrawn     String
  status        StreamStatus @@default(ACTIVE)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @@updatedAt @map("updated_at")
  events        StreamEvent[]

  @@index([donorId])
  @@index([ngoId])
  @@map("streams")
}

/// Append-only timeline of events for a stream, written by the indexer
/// as it observes donation-vault events. Exposed via GET /streams/:id/activity.
model StreamEvent {
  id        String          @id @default(uuid())
  streamId  String          @map("stream_id")
  stream    Stream          @relation(fields: [streamId], references: [id], onDelete: Cascade)
  type      StreamEventType
  /// Optional decimal string payload (amount for top-ups/withdrawals,
  /// new rate for rate changes), kept as a string for the same bigint
  /// precision reasons as the stream columns.
  amount    String?
  /// Ledger the event was observed at, used to order the timeline.
  ledger    Int?
  createdAt  DateTime        @default(now()) @map("created_at")

  @@index([streamId, createdAt])
  @@map("stream_events")
}

enum NgoApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Off-chain intake for prospective NGOs, reviewed by admins (next commit)
/// before anyone goes and calls the on-chain `approve_ngo`. Deliberately
/// separate from `Ngo.verified`: this tracks the review workflow, while
/// `Ngo.verified` stays sourced only from the contract's `approved` event
/// (handled by the indexer) so there's exactly one source of truth for
/// on-chain state.
model NgoApplication {
  id           String               @id @default(uuid())
  ownerAddress String               @map("owner_address")
  name         String
  description  String
  website       String?
  contactEmail String               @map("contact_email")
  country       String?
  status        NgoApplicationStatus @@default(PENDING)
  reviewNote    String?              @map("review_note")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @@updatedAt @map("updated_at")

  @@index([ownerAddress])
  @@index([status])
  @@map("ngo_applications")
}

/// Single-row-per-id table tracking how far the event indexer has gotten,
/// so a restart resumes instead of re-scanning from "now" every time.
model IndexerCheckpoint {
  id          String   @id @default("singleton")
  lastLedger  BigInt   @default(0)
  lastEventId String?  // Tracks the precise event ID or paging token within the ledger
  updatedAt    DateTime @@updatedAt

  @@map("indexer_checkpoints")
}
